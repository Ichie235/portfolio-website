# Production URL — used by sitemap.ts and robots.ts to generate absolute URLs.
# Set this in Vercel: Settings → Environment Variables → NEXT_PUBLIC_SITE_URL
# Example: https://chinemeremichie.com
NEXT_PUBLIC_SITE_URL=

# Availability badge shown in the Hero section.
# Values: open | freelance | closed (or leave blank to hide)
#   open      → green pulsing dot + "Open to opportunities"
#   freelance → amber pulsing dot + "Open to freelance"
#   closed    → badge hidden
NEXT_PUBLIC_AVAILABILITY=open

# Upstash Redis — used by the Guestbook to store and retrieve entries.
# Sign up at https://upstash.com → create a Redis database → copy REST URL and token.
# Add both to Vercel: Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub personal access token — optional, but increases rate limit from 60→5000 req/hr.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Resend API key — used by /api/contact to send contact form emails.
# Sign up at https://resend.com, create an API key, and paste it here.
# In production, add this in Vercel: Settings → Environment Variables → RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
